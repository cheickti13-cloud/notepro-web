# Copier ce fichier en .env puis adapter les valeurs. Ne JAMAIS versionner .env
DEBUG=True
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://notepro.mon-ecole.ci

# PostgreSQL (format : postgres://utilisateur:motdepasse@hote:port/base)
DATABASE_URL=postgres://notepro:notepro@localhost:5432/notepro

# Clé(s) Fernet pour chiffrer les données sensibles. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : ajouter la nouvelle clé EN PREMIER, garder l'ancienne après une virgule.
FIELD_ENCRYPTION_KEYS=

ETABLISSEMENT_NOM=Lycée NotePro
TIME_ZONE=Africa/Abidjan

# Durées de conservation RGPD (jours)
RGPD_NOTIFICATIONS_JOURS=180
RGPD_MESSAGES_JOURS=365
RGPD_JUSTIFICATIFS_JOURS=365
RGPD_JOURNAL_JOURS=365
